# Copy to server/.env and fill in. Loaded with: set -a && . ./.env && set +a
RANKED_ADMIN_KEY=change-me-to-a-long-random-string
RANKED_DB_PATH=ranked.db
# Only used ONCE, to create the first recurring schedule ("daily") in a new database.
# After that, manage schedules and fixed windows in the browser at https://<your-host>/admin.
RANKED_DAILY_START=18:00
RANKED_DAILY_DURATION_MINUTES=240
RANKED_SUBMIT_GRACE_MINUTES=180
# Pin auto-created windows to a game version (leave empty to allow any).
RANKED_GAME_VERSION=v0.113.1
# Characters a window can be assigned (comma-separated). Default: all six.
#RANKED_CHARACTERS=CHARACTER.IRONCLAD,CHARACTER.SILENT,CHARACTER.REGENT,CHARACTER.NECROBINDER,CHARACTER.DEFECT,CHARACTER.FOOL
# The /admin session cookie is HTTPS-only. Set to 0 only when testing over plain http://localhost.
#RANKED_COOKIE_SECURE=0
